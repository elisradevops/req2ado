generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A real, revocable server session -- opaque 32-byte token in an httpOnly
// cookie, only sha256(token) persisted here (never the raw token, same
// reasoning as never persisting a PAT in plaintext: a DB read alone must
// never be enough to impersonate a session). userId is the ADO
// authenticatedUser.descriptor (AdoPatProvider.validateAndIdentify), the
// same identity Job.userId/IngestedDocument.userId already key on.
// Revocation (logout) is a real DELETE, not a JWT that stays valid until
// expiry regardless of what the server thinks -- this is exactly why this
// is a DB-backed session and not a JWT.
model Session {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  userId       String
  displayName  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

// Server-side encrypted credential store -- the ADO PAT, SharePoint token,
// and (optional) per-user Open WebUI API key all live here now instead of
// being resent per-request by the browser (PAT) or living only in a shared
// server env var (SharePoint token, LLM key). AES-256-GCM via Node crypto
// (credential-vault.service.ts); `ciphertext`/`iv`/`authTag` are each
// base64. AAD is bound to `ownerKey|kind` at encrypt time so a ciphertext
// row can't be decrypted correctly if transplanted onto a different
// owner/kind pair. `ownerKey` is `user:<descriptor>` for per-user
// credentials (pat, llm_api_key) or the literal string `shared` for the
// one shared SharePoint token (matches today's single-shared-identity
// SharePoint design -- see docs/architecture.md). `keyVersion` records
// which of CREDENTIAL_ENC_KEY / CREDENTIAL_ENC_KEY_PREVIOUS decrypted this
// row, so rotating the encryption key can re-encrypt lazily instead of
// needing a big-bang migration.
model ExternalCredential {
  id         String   @id @default(uuid())
  ownerKey   String
  kind       String // "ado_pat" | "sharepoint_token" | "llm_api_key"
  ciphertext String
  iv         String
  authTag    String
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ownerKey, kind])
}

model Job {
  id               String    @id @default(uuid())
  mode             String // "baseline" | "survey"
  status           String // "pending" | "running" | "diff_ready" | "writing" | "succeeded" | "failed" | "rejected" | "cancelled"
  sourceHash       String
  areaPath         String
  // The submitting user's stable ADO identity (authenticatedUser.descriptor,
  // see AdoPatProvider) -- threaded into ingestion's /level call as the
  // Knowledge Base scope key (see IngestedDocument below), kept SEPARATE
  // from areaPath (the ADO write-back destination + idempotency key,
  // unrelated concern). Nullable: historical jobs predate this column.
  userId           String?
  customerId       String?
  // True when this job ingests a follow-up document against requirements
  // already ingested under the same area path -- gates whether
  // pipeline.worker.ts's diff() runs the dedup-similarity check at all.
  // Default false: a first-time ingestion has nothing to compare against,
  // so skipping the check is both correct and faster (no wasted embed
  // calls). See docs/runbook.md's "Duplicate Detection for Follow-up
  // Documents" backlog item.
  followUp         Boolean   @default(false)
  originalFilename String
  dryRunDiff       Json?
  state            String    @default("Proposed")
  iterationPath    String?
  // {sourceFile, similarity, relevance}[] -- structured citations (was a
  // bare TEXT[] of filenames; widened so a reviewer can see the actual
  // retrieval score and relevance verdict, not just "this file was
  // offered", per docs/runbook.md's KB-usage-visibility rationale.
  kbCitations      Json      @default("[]")
  // Tree-level integrity warnings surfaced by ingestion's /level response
  // (WorkItemTree.warnings, SURVEY-only) -- always [] for BASELINE. Persisted
  // here so getById() can return them alongside the diff for the reviewer.
  warnings         Json?
  // {figureIndex, caption}[] -- vision-model captions for every embedded
  // figure with a real caption (see /ingest's response `figures` array),
  // persisted so JobDetail's FigureDescriptions panel survives a reload or
  // reopening a completed job -- previously this lived ONLY in live SSE
  // narration state (pipeline.worker.ts populates this in the SAME
  // prisma.job.update as warnings/kbCitations above). Nullable: historical
  // jobs predate this column, same convention as warnings/userId.
  figureDescriptions Json?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  completedAt      DateTime?
  auditEntries     AuditEntry[]
  dedupSkipAudits  DedupSkipAudit[]
  createdItemMappings CreatedItemMapping[]
  sourceFile       JobSourceFile?
  events           JobEvent[]
}

// Retains the original uploaded file's bytes so a job can be re-submitted
// without the user re-uploading it -- kept in its OWN table, not a column
// on Job, so ordinary Job queries (list/getById) never pull large blob
// bytes along for the ride. Capped at MAX_STORED_SOURCE_BYTES
// (jobs.service.ts) -- an upload larger than the cap still processes
// normally, it just isn't retained for resubmit (no row is written).
// Deleted alongside its Job in JobsService.delete's transaction.
model JobSourceFile {
  jobId     String   @id
  job       Job      @relation(fields: [jobId], references: [id])
  bytes     Bytes
  createdAt DateTime @default(now())
}

model AuditEntry {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

// Durable counterpart to the Redis-backed narration-log (ingestion's
// NarrationPublisher / orchestrator's JobEventsPublisher) -- that Redis list
// is capped at 50 entries with a 1-hour TTL, purely a live-SSE-replay buffer;
// this table is the permanent record, written by JobEventPersistenceService
// (a background Redis psubscribe('job-events:*') consumer, decoupled from
// the per-connection SSE controller) so a job's full processing trail
// survives past its own completion/failure and past Redis's TTL. `detail`
// carries the full narration/stage payload as received (phase-specific
// fields like sampleTitles/subtreeIndex/errorType, not just the formatted
// `message` string) for the event-history endpoint to render richly.
model JobEvent {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  phase     String
  message   String
  detail    Json?
  severity  String   @default("info") // "info" | "warning" | "error"
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

// Durable, structured audit trail for skipped duplicates (distinct from
// AuditEntry's free-text messages) -- one row per node whose dry-run diff
// action was 'dedup_skip', written at diff-ready time in pipeline.worker.ts.
// Queryable per job for real audit/reporting, not just an in-memory count.
model DedupSkipAudit {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  localId       String
  similarity    Float
  existingAdoId Int
  createdAt     DateTime @default(now())
}

// Throttle state for BackfillService.backfillAreaPath -- runPipelineJob
// now auto-runs a backfill for its own job.areaPath (closing the
// "manually-created ADO items are invisible to dedup" gap, previously
// only reachable via a raw, undiscoverable POST /backfill admin call),
// but a full area-path WIQL scan + batch fetch + embed + upsert is real
// cost that shouldn't repeat on every single job against a busy, already-
// backfilled area path. One row per area path; missing or stale
// (>staleAfterMs, see pipeline.worker.ts's maybeBackfillAreaPath) means
// due for another scan.
model AreaPathBackfill {
  areaPath         String   @id
  lastBackfilledAt DateTime
}

// Durable local-id -> ADO-id resume state for confirm() (the "P4b" tree
// previously flagged as "not yet built" -- see JobsService.confirm's own
// prior doc comment). Written immediately after each create/link succeeds
// (not batched at the end), so a failure partway through confirm() leaves
// correct state for a safe retry: a retry skips any localId that already
// has a row here (already created in THIS or a PRIOR attempt at this job),
// and skips re-linking any row already marked `linked`. Distinct from
// IdempotencyMapping below, which is scoped by content hash across DIFFERENT
// jobs/re-runs -- this one is scoped to a single job's own confirm() retries.
model CreatedItemMapping {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  localId       String
  adoWorkItemId Int
  linked        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([jobId, localId])
}

// Idempotency map: prevents duplicate ADO writes on job re-run.
// See docs/architecture.md 1c: (source_hash, customer_id, area_path) -> System.Id
model IdempotencyMapping {
  id           String @id @default(uuid())
  sourceHash   String
  customerId   String?
  areaPath     String
  adoWorkItemId Int

  @@unique([sourceHash, customerId, areaPath])
}

// Non-secret metadata for a document ingested into the KB from a
// SharePoint/OneDrive sharing link via Microsoft Graph. No token or content
// is stored here — chunk text + embeddings live in the Chroma KB collection;
// this table only records what has been ingested, for display/listing.
// Keyed [userId, driveItemId] -- User-scoped (the ingesting user's stable
// ADO identity, see Job.userId's own doc comment), NOT areaPath. Previously
// scoped by areaPath, which conflated "who owns this KB document" with "what
// ADO destination a later job happens to target" -- a job whose ADO area
// path didn't match the ingesting area path silently got zero KB grounding
// even though the same person owned both. Re-ingesting the same document
// (same user, same driveItemId) updates the same row rather than
// duplicating it; the SAME SharePoint file ingested by two different users
// is tracked as two independent rows (each user's own KB copy).
model IngestedDocument {
  id            String   @id @default(uuid())
  userId        String
  driveItemId   String
  name          String
  sizeBytes     Int
  mimeType      String?
  docType       String?
  // "retrieve" (default, null also means this) or "always_include" -- see
  // KbVectorStore.upsert_chunk's own docstring (ingestion side). Persisted
  // here too so the KB document list UI can show/edit a file's mode without
  // a round trip to ingestion's Chroma-backed store.
  retrievalMode String?
  ingestedAt    DateTime @default(now())

  @@unique([userId, driveItemId])
}

// One row per chat turn (user message or assistant reply) on a single
// dry-run diff entry. A log, not a state machine — acceptance of a
// proposal is a normal editDiffEntry PATCH, not tracked here. See
// docs/superpowers/specs/2026-07-15-p3b-ai-assist-chat-design.md §4.
model ChatMessage {
  id                  String   @id @default(uuid())
  jobId               String
  localId             String
  role                String // "user" | "assistant"
  content             String
  proposedTitle       String?
  proposedDescription String?
  model               String? // assistant turns only — which model produced this reply
  createdAt           DateTime @default(now())

  @@index([jobId, localId])
}
