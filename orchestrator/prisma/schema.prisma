generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id               String    @id @default(uuid())
  mode             String // "baseline" | "survey"
  status           String // "pending" | "running" | "diff_ready" | "writing" | "succeeded" | "failed"
  sourceHash       String
  areaPath         String
  state            String    @default("Proposed")
  iterationPath    String?
  customerId       String?
  originalFilename String
  dryRunDiff       Json?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  completedAt      DateTime?
  auditEntries     AuditEntry[]
}

model AuditEntry {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

// Idempotency map: prevents duplicate ADO writes on job re-run.
// See docs/architecture.md 1c: (source_hash, customer_id, area_path) -> System.Id
model IdempotencyMapping {
  id           String @id @default(uuid())
  sourceHash   String
  customerId   String?
  areaPath     String
  adoWorkItemId Int

  @@unique([sourceHash, customerId, areaPath])
}

// Non-secret metadata for a document ingested into the KB from a
// SharePoint/OneDrive sharing link via Microsoft Graph. No token or content
// is stored here — chunk text + embeddings live in the Chroma KB collection;
// this table only records what has been ingested, for display/listing.
// Keyed [areaPath, driveItemId] so re-ingesting the same document updates
// the same row rather than duplicating it.
model IngestedDocument {
  id          String   @id @default(uuid())
  areaPath    String
  driveItemId String
  name        String
  sizeBytes   Int
  mimeType    String?
  docType     String?
  ingestedAt  DateTime @default(now())

  @@unique([areaPath, driveItemId])
}
