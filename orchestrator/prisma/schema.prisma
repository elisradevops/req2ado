generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A real, revocable server session -- opaque 32-byte token in an httpOnly
// cookie, only sha256(token) persisted here (never the raw token, same
// reasoning as never persisting a PAT in plaintext: a DB read alone must
// never be enough to impersonate a session). userId is the ADO
// authenticatedUser.descriptor (AdoPatProvider.validateAndIdentify), the
// same identity Job.userId/IngestedDocument.userId already key on.
// Revocation (logout) is a real DELETE, not a JWT that stays valid until
// expiry regardless of what the server thinks -- this is exactly why this
// is a DB-backed session and not a JWT.
model Session {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  userId       String
  displayName  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

// Server-side encrypted credential store -- the ADO PAT, SharePoint token,
// and (optional) per-user Open WebUI API key all live here now instead of
// being resent per-request by the browser (PAT) or living only in a shared
// server env var (SharePoint token, LLM key). AES-256-GCM via Node crypto
// (credential-vault.service.ts); `ciphertext`/`iv`/`authTag` are each
// base64. AAD is bound to `ownerKey|kind` at encrypt time so a ciphertext
// row can't be decrypted correctly if transplanted onto a different
// owner/kind pair. `ownerKey` is `user:<descriptor>` for per-user
// credentials (pat, llm_api_key) or the literal string `shared` for the
// one shared SharePoint token (matches today's single-shared-identity
// SharePoint design -- see docs/architecture.md). `keyVersion` records
// which of CREDENTIAL_ENC_KEY / CREDENTIAL_ENC_KEY_PREVIOUS decrypted this
// row, so rotating the encryption key can re-encrypt lazily instead of
// needing a big-bang migration.
model ExternalCredential {
  id         String   @id @default(uuid())
  ownerKey   String
  kind       String // "ado_pat" | "sharepoint_token" | "llm_api_key"
  ciphertext String
  iv         String
  authTag    String
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ownerKey, kind])
}

model Job {
  id               String    @id @default(uuid())
  mode             String // "baseline" | "survey"
  status           String // "pending" | "running" | "diff_ready" | "writing" | "succeeded" | "failed" | "rejected" | "cancelled"
  sourceHash       String
  areaPath         String
  // The submitting user's stable ADO identity (authenticatedUser.descriptor,
  // see AdoPatProvider) -- threaded into ingestion's /level call as the
  // Knowledge Base scope key (see IngestedDocument below), kept SEPARATE
  // from areaPath (the ADO write-back destination + idempotency key,
  // unrelated concern). Nullable: historical jobs predate this column.
  userId           String?
  // Deprecated/legacy, kept for historical rows only -- no longer written
  // by any submit path. Customer ID has no job/document-level meaning;
  // it's now a per-Requirement, document-derived attribute (see
  // ingestion/app/leveling/id_hierarchy.py, WorkItemNode.customer_id).
  customerId       String?
  // Set only for a Job created by BatchService.pumpOnce() (NEW-05 batch/
  // folder ingestion) -- deliberately a plain indexed scalar, NOT a Prisma
  // relation to JobBatch: a relation would pull JobBatch into
  // JobsService.delete's transaction and JobRetentionService.sweep's
  // deletion-order list for every ordinary single-file job too. Same
  // relation-free convention as IdempotencyMapping. Null for every job
  // submitted outside a batch (the overwhelming majority, unchanged).
  batchId          String?
  // DEAD COLUMN, kept unused rather than dropped (audit finding WID
  // 300567): was meant to gate the dedup-similarity check to follow-up
  // documents only, but dedup already runs unconditionally on every job
  // regardless of this value (pipeline.worker.ts never branches on it) --
  // confirmed no application code reads or writes this field anymore.
  // Column retained for the same reason the old job-level Customer ID
  // columns were kept: avoid a destructive migration for historical rows.
  followUp         Boolean   @default(false)
  originalFilename String
  dryRunDiff       Json?
  state            String    @default("Proposed")
  iterationPath    String?
  // {sourceFile, similarity, relevance}[] -- structured citations (was a
  // bare TEXT[] of filenames; widened so a reviewer can see the actual
  // retrieval score and relevance verdict, not just "this file was
  // offered", per docs/runbook.md's KB-usage-visibility rationale.
  kbCitations      Json      @default("[]")
  // Tree-level integrity warnings surfaced by ingestion's /level response
  // (WorkItemTree.warnings, SURVEY-only) -- always [] for BASELINE. Persisted
  // here so getById() can return them alongside the diff for the reviewer.
  warnings         Json?
  // {figureIndex, caption}[] -- vision-model captions for every embedded
  // figure with a real caption (see /ingest's response `figures` array),
  // persisted so JobDetail's FigureDescriptions panel survives a reload or
  // reopening a completed job -- previously this lived ONLY in live SSE
  // narration state (pipeline.worker.ts populates this in the SAME
  // prisma.job.update as warnings/kbCitations above). Nullable: historical
  // jobs predate this column, same convention as warnings/userId.
  figureDescriptions Json?
  // {tableId, caption}[] -- Table.caption for every table that has one (see
  // doc.tables, ingestion's canonical Table model), persisted so a "Table
  // tN" chip (NodeDetailPanel.tsx) can show a readable title instead of the
  // raw internal id. Only tables with a real caption are included, same
  // "nothing to show" convention figureDescriptions above already uses --
  // a table with no caption falls back to a friendlier ordinal derived from
  // its id client-side, not an entry here. Populated in the SAME
  // prisma.job.update as figureDescriptions/warnings/kbCitations. Nullable:
  // historical jobs predate this column, same convention as
  // figureDescriptions.
  tableDescriptions Json?
  // Doc-wide figure/table local ids the mapping stage (Part B) judged
  // decorative/irrelevant, or that failed mapping (WorkItemTree.
  // excluded_figure_ids/excluded_table_ids, ingestion's /level response) --
  // NOT every figure/table not attached to a node (a table judged
  // EMPTY_TABLE_CONTENT lands in neither table_ids nor this field, a
  // separate pre-existing warning bucket). Persisted here so getById() can
  // return them alongside kbCitations/warnings above (same
  // prisma.job.update call in pipeline.worker.ts). Nullable: historical
  // jobs predate these columns, same convention as warnings/figureDescriptions.
  excludedFigureIds Json?
  excludedTableIds  Json?
  // Telemetry for the SURVEY cost estimate (DESIGN.md §11.2.3) -- lets the
  // ETA be computed from this deployment's own real completed-job
  // durations instead of a hand-picked constant (two of which were tried
  // and found wrong by ~4-5x against a real ~90-minute job). All five are
  // nullable: historical jobs predate these columns, same convention as
  // warnings/userId/figureDescriptions above. No backfill -- recovering
  // them would mean re-parsing every retained source blob, and job history
  // was already wiped to zero by an account reset before this shipped, so
  // the value of backfilling is ~zero. Nullable-forever is the answer, not
  // an oversight.
  //
  // blockCount/figureCount: doc.blocks.length/doc.figures.length at the
  // SAME point jobs.controller.ts's preview() counts them, so the ETA
  // fit trains on the identical quantity it predicts against.
  blockCount       Int?
  figureCount      Int?
  // The EFFECTIVE model this job ran under (job.model ?? the orchestrator's
  // configured default), not the raw per-job override alone -- an override
  // is null for every job that used the default, which would make the
  // largest, most common cohort invisible to the ETA's per-model
  // adjustment. Always null for BASELINE, which never calls a model at all.
  model            String?
  // Real pipeline wall-clock boundaries for the ETA fit. Deliberately NOT
  // createdAt -> completedAt: completedAt is set only inside confirm()
  // (jobs.service.ts), i.e. when a human clicks approve -- that span
  // includes unbounded reviewer idle time, and fitting a document-size
  // regression on it would fit lunch breaks. startedAt is the
  // pending->running transition; diffReadyAt is pipeline completion
  // (running -> diff_ready), independent of whether a human ever reviews
  // it and independent of whether they confirm or reject.
  startedAt        DateTime?
  diffReadyAt      DateTime?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  completedAt      DateTime?
  auditEntries     AuditEntry[]
  dedupSkipAudits  DedupSkipAudit[]
  createdItemMappings CreatedItemMapping[]
  sourceFile       JobSourceFile?
  events           JobEvent[]
  figureFiles      JobFigureFile[]
  traceLinkFailures JobTraceLinkFailure[]

  @@index([batchId])
}

// Retains the original uploaded file's bytes so a job can be re-submitted
// without the user re-uploading it -- kept in its OWN table, not a column
// on Job, so ordinary Job queries (list/getById) never pull large blob
// bytes along for the ride. Capped at MAX_STORED_SOURCE_BYTES
// (jobs.service.ts) -- an upload larger than the cap still processes
// normally, it just isn't retained for resubmit (no row is written).
// Deleted alongside its Job in JobsService.delete's transaction.
model JobSourceFile {
  jobId     String   @id
  job       Job      @relation(fields: [jobId], references: [id])
  bytes     Bytes
  createdAt DateTime @default(now())
}

model AuditEntry {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

// Durable counterpart to the Redis-backed narration-log (ingestion's
// NarrationPublisher / orchestrator's JobEventsPublisher) -- that Redis list
// is capped at 50 entries with a 1-hour TTL, purely a live-SSE-replay buffer;
// this table is the permanent record, written by JobEventPersistenceService
// (a background Redis psubscribe('job-events:*') consumer, decoupled from
// the per-connection SSE controller) so a job's full processing trail
// survives past its own completion/failure and past Redis's TTL. `detail`
// carries the full narration/stage payload as received (phase-specific
// fields like sampleTitles/subtreeIndex/errorType, not just the formatted
// `message` string) for the event-history endpoint to render richly.
model JobEvent {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  phase     String
  message   String
  detail    Json?
  severity  String   @default("info") // "info" | "warning" | "error"
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

// Durable, structured audit trail for skipped duplicates (distinct from
// AuditEntry's free-text messages) -- one row per node whose dry-run diff
// action was 'dedup_skip', written at diff-ready time in pipeline.worker.ts.
// Queryable per job for real audit/reporting, not just an in-memory count.
model DedupSkipAudit {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  localId       String
  similarity    Float
  existingAdoId Int
  createdAt     DateTime @default(now())
}

// Throttle state for BackfillService.backfillAreaPath -- runPipelineJob
// now auto-runs a backfill for its own job.areaPath (closing the
// "manually-created ADO items are invisible to dedup" gap, previously
// only reachable via a raw, undiscoverable POST /backfill admin call),
// but a full area-path WIQL scan + batch fetch + embed + upsert is real
// cost that shouldn't repeat on every single job against a busy, already-
// backfilled area path. One row per area path; missing or stale
// (>staleAfterMs, see pipeline.worker.ts's maybeBackfillAreaPath) means
// due for another scan.
model AreaPathBackfill {
  areaPath         String   @id
  lastBackfilledAt DateTime
}

// Durable local-id -> ADO-id resume state for confirm() (the "P4b" tree
// previously flagged as "not yet built" -- see JobsService.confirm's own
// prior doc comment). Written immediately after each create/link succeeds
// (not batched at the end), so a failure partway through confirm() leaves
// correct state for a safe retry: a retry skips any localId that already
// has a row here (already created in THIS or a PRIOR attempt at this job),
// and skips re-linking any row already marked `linked`. Distinct from
// IdempotencyMapping below, which is scoped by content hash across DIFFERENT
// jobs/re-runs -- this one is scoped to a single job's own confirm() retries.
model CreatedItemMapping {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  localId       String
  adoWorkItemId Int
  linked        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([jobId, localId])
}

// Ingestion-captured, already-compressed bytes for an embedded figure (see
// ingestion/app/main.py's _describe_figure_with_progress) -- written for
// EVERY figure at ingest time (relevance isn't known yet), then pruned down
// to only the figures a node's figure_ids actually reference once /level
// returns (pipeline.worker.ts), and deleted immediately on a successful ADO
// attachment upload in confirm() -- unlike JobSourceFile (kept for
// resubmit), a copy here serves no purpose once the bytes are safely in ADO.
// Own table, same reasoning as JobSourceFile: ordinary Job queries must
// never drag image bytes along. Keyed (jobId, figureId) only, NEVER by
// filename/document identity -- a revised document is a new job with fresh
// Figure ids, so there is no path by which an old job's stored figure could
// be confused with a new job's regardless of filename reuse. Same
// ON DELETE RESTRICT + explicit-transaction-delete convention as every
// other Job-child table (see JobsService.delete, JobRetentionService.sweep).
model JobFigureFile {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  figureId  String // matches Figure.id ("f0".."f38") -- same id figure_ids references
  bytes     Bytes
  mimeType  String
  createdAt DateTime @default(now())

  @@unique([jobId, figureId])
}

// Resume-by-existence, same idiom as JobFigureFile above: a row exists only
// while a trace-link write is still outstanding, and is deleted... except
// there is no delete here yet -- Task 3 (retry endpoint) owns clearing a row
// once a retried write succeeds. Written by confirm()'s per-link catch
// (jobs.service.ts) as a best-effort bookkeeping step alongside the
// existing console.error -- a trace-link write failure (rejected rel,
// deleted crossJob target, transient network error, or the documented
// residual same-endpoint race after grouping-by-source, see confirm()'s own
// comment) must not abort confirm() once work items in the call have
// already been created/parented, but today it also left zero persistence,
// zero user visibility, and zero recovery path once the job succeeded. This
// table plus the WarningRecord confirm() appends on success (kind:
// 'trace_link_write_failed') close that gap; Task 3's retry endpoint reads
// these rows by (jobId, sourceAdoId, targetAdoId, referenceName).
// Upserted, not created: a retried confirm() re-attempting the same link
// must overwrite the stored error, never 500 on the unique constraint below.
model JobTraceLinkFailure {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  sourceLocalId String // matches DryRunDiffEntry.traceLinks[].sourceLocalId, so the UI can map a row back to the link it renders
  sourceAdoId   Int
  targetAdoId   Int
  referenceName String
  error         String
  createdAt     DateTime @default(now())

  @@unique([jobId, sourceAdoId, targetAdoId, referenceName])
}

// Idempotency map: prevents duplicate ADO writes on job re-run.
// See docs/architecture.md 1c: (source_hash, area_path) -> System.Id
// customerId is kept as an unused legacy column (historical rows only --
// Customer ID no longer has any job/document-level meaning; it's now a
// per-Requirement, document-derived attribute -- see id_hierarchy.py) so no
// destructive DROP COLUMN is needed for this refactor.
model IdempotencyMapping {
  id           String @id @default(uuid())
  sourceHash   String
  customerId   String?
  areaPath     String
  adoWorkItemId Int

  @@unique([sourceHash, areaPath])
}

// Single global row of user-editable, live-tunable parameters (Settings
// window, NEW-07) -- deliberately NOT per-user: every logged-in user sees
// and can change the same value, matching this app's existing no-app-RBAC
// posture (ADO identity is the only real access gate). Fixed `id` enforces
// the singleton via the same @id-uniqueness Prisma already gives every
// model, no separate uniqueness mechanism needed. New fields for future
// settings belong here, nullable/defaulted the same way every other
// additive column in this schema is.
model AppSettings {
  id             String   @id @default("singleton")
  // Dedup near-duplicate similarity threshold (see check_for_duplicates.py),
  // previously hardcoded to 0.90 and documented as "fixed, not tunable" --
  // default here is that same 0.90 so a fresh deployment with no row yet
  // (or a row never edited) behaves byte-identical to the old hardcoded
  // behavior.
  dedupThreshold Float    @default(0.90)
  updatedAt      DateTime @updatedAt
}

// Non-secret metadata for a document ingested into the KB from a
// SharePoint/OneDrive sharing link via Microsoft Graph. No token or content
// is stored here — chunk text + embeddings live in the Chroma KB collection;
// this table only records what has been ingested, for display/listing.
// Keyed [userId, driveItemId] -- User-scoped (the ingesting user's stable
// ADO identity, see Job.userId's own doc comment), NOT areaPath. Previously
// scoped by areaPath, which conflated "who owns this KB document" with "what
// ADO destination a later job happens to target" -- a job whose ADO area
// path didn't match the ingesting area path silently got zero KB grounding
// even though the same person owned both. Re-ingesting the same document
// (same user, same driveItemId) updates the same row rather than
// duplicating it; the SAME SharePoint file ingested by two different users
// is tracked as two independent rows (each user's own KB copy).
model IngestedDocument {
  id            String   @id @default(uuid())
  userId        String
  driveItemId   String
  name          String
  sizeBytes     Int
  mimeType      String?
  docType       String?
  // "retrieve" (default, null also means this) or "always_include" -- see
  // KbVectorStore.upsert_chunk's own docstring (ingestion side). Persisted
  // here too so the KB document list UI can show/edit a file's mode without
  // a round trip to ingestion's Chroma-backed store.
  retrievalMode String?
  ingestedAt    DateTime @default(now())

  @@unique([userId, driveItemId])
}

// One row per chat turn (user message or assistant reply) on a single
// dry-run diff entry. A log, not a state machine — acceptance of a
// proposal is a normal editDiffEntry PATCH, not tracked here. See
// docs/superpowers/specs/2026-07-15-p3b-ai-assist-chat-design.md §4.
model ChatMessage {
  id                  String   @id @default(uuid())
  jobId               String
  localId             String
  role                String // "user" | "assistant"
  content             String
  proposedTitle       String?
  proposedDescription String?
  model               String? // assistant turns only — which model produced this reply
  createdAt           DateTime @default(now())

  @@index([jobId, localId])
}

// NEW-05 batch/folder ingestion -- the shared submission config for a set
// of files uploaded together (area path, mode, etc). Deliberately
// NOT a parent of Job (see Job.batchId's own doc comment: relation-free by
// design) -- this row exists purely for aggregate listing/reporting
// (BatchService.getBatch/listBatches), never as a lookup Job rows depend on.
// Named JobBatch (not BatchJob) to match this schema's existing Job*-prefixed
// child-table convention (JobSourceFile, JobEvent, JobFigureFile).
model JobBatch {
  id            String   @id @default(uuid())
  userId        String
  areaPath      String
  // Deprecated/legacy, kept for historical rows only -- see Job.customerId's
  // own doc comment.
  customerId    String?
  mode          String // "baseline" | "survey"
  state         String?
  iterationPath String?
  model         String?
  // DEAD COLUMN, kept unused -- see Job.followUp's own doc comment (same
  // audit finding, WID 300567).
  followUp      Boolean  @default(false)
  createdAt     DateTime @default(now())
  files         JobBatchFile[]
}

// One row per file selected in a batch upload -- the per-file status ledger
// BatchService.pumpOnce() advances as it submits each file as an ordinary
// Job. `jobId` is set only once the file has actually been submitted via
// the existing JobsService.submit() (see BatchService's own doc comment on
// why a Job row must never exist before real enqueue: JobsService.
// onModuleInit's orphan reconciliation would mark a pre-enqueued, queue-less
// Job 'failed' on the very next orchestrator restart). Relation-free to Job
// for the same reason Job.batchId is relation-free to JobBatch.
model JobBatchFile {
  id          String    @id @default(uuid())
  batchId     String
  batch       JobBatch  @relation(fields: [batchId], references: [id])
  ordinal     Int
  filename    String
  sizeBytes   Int
  sourceHash  String
  // "queued" | "submitting" | "submitted" | "invalid" | "submit_failed" | "cancelled"
  status      String
  error       String?
  jobId       String?
  // When this row's optimistic claim (status flipped to 'submitting') was
  // made -- distinct from createdAt (when the row was first queued, which
  // could be long before it was ever claimed). BatchService.pumpOnce()
  // reclaims a 'submitting' row back to 'queued' once claimedAt is older
  // than BATCH_SUBMIT_STUCK_MS, covering a crash between the claim and the
  // real JobsService.submit() call.
  claimedAt   DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  blob        JobBatchFileBlob?

  @@index([batchId, ordinal])
  @@index([status, createdAt])
}

// A queued file's bytes, held only until BatchService.pumpOnce() submits it
// as a real Job (which gets its own JobSourceFile copy at that point) --
// own table, same "ordinary queries never drag blob bytes along" convention
// as JobSourceFile/JobFigureFile. Deleted in the same transaction that
// marks its JobBatchFile 'submitted'; retained on 'submit_failed' so a
// future retry doesn't require a re-upload.
model JobBatchFileBlob {
  batchFileId String       @id
  batchFile   JobBatchFile @relation(fields: [batchFileId], references: [id])
  bytes       Bytes
  createdAt   DateTime     @default(now())
}
