generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id               String    @id @default(uuid())
  mode             String // "baseline" | "survey"
  status           String // "pending" | "running" | "diff_ready" | "writing" | "succeeded" | "failed"
  sourceHash       String
  areaPath         String
  state            String    @default("Proposed")
  iterationPath    String?
  customerId       String?
  originalFilename String
  dryRunDiff       Json?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  completedAt      DateTime?
  auditEntries     AuditEntry[]
}

model AuditEntry {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

// Idempotency map: prevents duplicate ADO writes on job re-run.
// See docs/architecture.md 1c: (source_hash, customer_id, area_path) -> System.Id
model IdempotencyMapping {
  id           String @id @default(uuid())
  sourceHash   String
  customerId   String?
  areaPath     String
  adoWorkItemId Int

  @@unique([sourceHash, customerId, areaPath])
}

// Non-secret SharePoint connector config only — the bearer token used to
// Sync is never persisted, matching docs/docgen-connection-pattern.md's
// "only non-secret config persists server-side" rule.
model KbSource {
  id           String    @id @default(uuid())
  areaPath     String
  siteUrl      String
  library      String
  folder       String
  displayName  String
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
}
