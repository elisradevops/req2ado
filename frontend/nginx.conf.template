# frontend/nginx.conf.template
#
# Templated (not a static conf) so the orchestrator upstream is env-driven:
# 127.0.0.1:3001 in the consolidated k8s pod (orchestrator is a sibling
# container on localhost), orchestrator:3001 in docker-compose (a separate
# container). The nginx:1.27-alpine base image's own entrypoint script
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) renders every
# /etc/nginx/templates/*.template into /etc/nginx/conf.d/ automatically on
# container start -- no custom ENTRYPOINT needed. It substitutes only
# names that are actual environment variables, so nginx's own $uri-style
# variables below are left untouched.
#
# Consolidating the frontend and orchestrator behind one origin (see
# docs/design-decisions.md's runtime-config rationale) removes the need for
# CORS entirely -- the browser only ever talks to this nginx origin.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Diagnostics for the job event stream (an unexplained 503 was seen once on a reconnect). One extra line per /events request: who answered
# (status vs upstream_status: a 503 here with an empty upstream_status means nginx itself produced it), which upstream, and the timings.
# No headers, cookies or bodies are logged.
map $uri $log_job_events {
    default 0;
    ~/events$ 1;
}
log_format job_events '$time_iso8601 events status=$status upstream_status=$upstream_status upstream=$upstream_addr '
                      'request_time=$request_time upstream_response_time=$upstream_response_time bytes=$body_bytes_sent uri=$uri';

server {
    listen 80;
    access_log /dev/stdout job_events if=$log_job_events;
    root /usr/share/nginx/html;
    index index.html;

    # MAX_UPLOAD_SIZE_MB=50 (req2ado-config) -- nginx's own default is 1m,
    # which would reject every real document upload before it ever reaches
    # the orchestrator.
    client_max_body_size 50m;

    # Same-origin API proxy. /api/foo -> upstream's /foo (the orchestrator
    # itself has no /api prefix on its routes).
    location /api/ {
        # The upstream sits in a variable so nginx re-resolves its name
        # (valid=10s) instead of once at startup: recreating the orchestrator
        # container gives it a new IP, and a startup-resolved upstream kept
        # proxying to the old one (502 on every /api call until nginx was
        # restarted). With a variable, nginx no longer strips the matched
        # /api/ prefix itself, hence the explicit rewrite. DNS_RESOLVER is
        # Docker's embedded DNS by default; an IP-literal UPSTREAM_HOST (the
        # k8s pod's 127.0.0.1) never uses it.
        resolver ${DNS_RESOLVER} valid=10s;
        set $api_upstream http://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # SSE (frontend/src/api/events.ts's EventSource) needs unbuffered
        # proxying -- with the nginx default (proxy_buffering on), job
        # progress events queue up behind nginx's buffer instead of
        # streaming, and the UI never updates until the buffer flushes.
        proxy_buffering off;
        # Matches INGESTION_REQUEST_TIMEOUT_MS=3600000 (req2ado-config) --
        # a SURVEY-mode /level call can legitimately take up to an hour;
        # nginx's 60s default would sever the connection long before that.
        proxy_read_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # ChatGateway's raw `ws` WebSocket adapter (orchestrator/src/main.ts)
        # -- needed if any future client ever upgrades a /api/ connection.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # SPA fallback: any path not matching a real static file or /api/ above
    # serves index.html so client-side routing works.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
