# --- LLM (Open WebUI or Ollama's OpenAI-compatible endpoint, e.g. http://localhost:11434/v1) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBED_MODEL=
EMBED_TRANSPORT=ollama
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_PATH=/api/embed
# /api/embed = direct Ollama (dev). /ollama/api/embed = Open WebUI proxy (production on-prem).
# A vision-capable model (e.g. llava, bakllava, moondream) -- when set,
# embedded figures/diagrams get a real LLM-generated description instead of
# an empty [FIGURE: none] placeholder. Unset = same placeholder-only
# behavior as before this option existed.
LLM_VISION_MODEL=
LLM_TRUSTED_LOCAL=false
LLM_PROXY_BEARER=
# Timeout (ms) for a single OpenAI-SDK chat/vision call to the LLM proxy.
# Default 600000 (10 min) matches the SDK's own prior default -- now explicit
# and paired with maxRetries:0 so a timeout surfaces immediately instead of
# silently re-running a multi-minute inference up to 3 times.
LLM_REQUEST_TIMEOUT_MS=
# How many of a SURVEY document's independent top-level branches ingestion
# analyzes concurrently. Unset/1 = fully sequential (current default,
# zero risk). This is a client-side fan-out, NOT a request for more LLM
# backend capacity -- raising it only helps if the configured LLM_BASE_URL
# backend can itself serve more than one generation at a time. A local
# single-GPU Ollama instance with default settings (one parallel slot)
# gains nothing from this; requests just queue backend-side instead of in
# this loop. In a shared multi-tenant deployment (e.g. an Open WebUI/Ollama
# cluster already serving many human users' own chats), raise this ONLY in
# coordination with whoever operates that backend's own concurrency limit
# (OLLAMA_NUM_PARALLEL or equivalent) -- setting this higher than the
# backend can truly serve concurrently adds queueing delay for every other
# user without buying this job anything back.
SURVEY_BRANCH_CONCURRENCY=
# Chunk-level counterpart to SURVEY_BRANCH_CONCURRENCY above: how many of a
# chunked LLM enhancement pass's independent chunks (title/tag, requirement
# synthesis, Epic/Feature summary, and both quality-scoring passes) may be
# in flight at once. Default 1 = the previous strictly-sequential behavior,
# zero risk. The two dials never compound (no chunked pass runs inside a
# branch worker), so total in-flight requests is max of the two, not the
# product. Every caveat on SURVEY_BRANCH_CONCURRENCY above applies here
# unchanged -- this is a client-side fan-out, and raising it only helps if
# the configured backend can genuinely serve more than one generation at a
# time.
SURVEY_CHUNK_CONCURRENCY=
# How many figures /ingest may caption concurrently. Default 1 = the
# previous strictly-sequential, one-vision-call-per-figure behavior, zero
# risk. Independent of the SURVEY_*_CONCURRENCY dials above: this is a
# different model behind a different client (LLM_VISION_MODEL), and it runs
# during /ingest rather than /level, so the dials never overlap. Every
# caveat above applies here unchanged -- raising this only helps if the
# configured vision backend can genuinely serve more than one generation at
# a time.
VISION_CAPTION_CONCURRENCY=

# --- ADO (on-prem TFS/ADO Server) ---
ADO_BASE_URL=
ADO_PROJECT=
ADO_AREA_PATH=
ADO_CA_CERT=
# Initial System.State written on every created work item -- defaults to
# "Proposed" (unset = same behavior as before this option existed). Override
# if the target process template's initial workflow state has a different
# name (e.g. a custom on-prem process).
ADO_INITIAL_STATE=
# Comma-separated candidate field ref names tried, in order, for the
# Customer ID custom field (unset = default list: Custom.CustomerId,
# Custom.CustomerRequirementId, Custom.CustomerID). Override if your org's
# process template uses a different field name.
CUSTOMER_ID_FIELD_CANDIDATES=
# Comma-separated candidate field ref names tried, in order, for the
# requirement-classification field (unset = default list:
# Microsoft.VSTS.CMMI.RequirementType, Custom.Requirement_Type). Override if
# your org's process template uses a different field name.
REQUIREMENT_TYPE_FIELD_CANDIDATES=
# PAT is NOT set here — entered per-user at the login screen, then vaulted
# server-side (encrypted, see CREDENTIAL_ENC_KEY below) rather than kept in
# the browser or resent per-request.

# --- Our MCP server (ADO write/read tools) ---
MCP_URL=
MCP_BEARER=
# Wall-clock cap (ms) on a single MCP round trip. Default 60000 if unset.
MCP_REQUEST_TIMEOUT_MS=

# --- Credential vault (ExternalCredential table: ADO PAT, SharePoint token,
# optional per-user LLM key) -- see credential-vault.service.ts. Required,
# no default: there is no safe default for a secret-encryption key.
CREDENTIAL_ENC_KEY=
# Optional: the previous CREDENTIAL_ENC_KEY value, kept for one rotation
# cycle so existing vaulted credentials decrypt via fallback and get
# lazily re-encrypted under the new key, instead of needing a bulk migration.
CREDENTIAL_ENC_KEY_PREVIOUS=

# --- SharePoint / OneDrive KB ingest (Microsoft Graph) ---
# Bearer access token for Microsoft Graph, read by the ingestion service at
# GraphClient construction time. SHAREPOINT_TOKEN is primary; GRAPH_TOKEN is
# the accepted fallback. Needs a Graph "Files.Read" (delegated) permission at
# minimum — verified sufficient for ingesting a file shared with/accessible to
# the signed-in user via a sharing link; "Files.Read.All" also works if your
# tenant allows granting it, but isn't required for this connector's use case
# (Azure AD app registration, or a token minted from Microsoft Graph Explorer).
# Accepted link hosts: *.sharepoint.com, *.onedrive.com, *.sharepoint.us,
# onedrive.live.com, and 1drv.ms (OneDrive short links). The access token is
# short-lived (~1h) with NO auto-refresh — an expired token surfaces
# as HTTP 401 on ingest and must be replaced. Unlike the ADO PAT, this is a
# single shared SERVER identity (every KB ingest uses it), not per-user. Leave
# blank if not using SharePoint KB ingest — ingestion still boots; the
# /kb/ingest-url route just 400s until a token is set.
SHAREPOINT_TOKEN=
# GRAPH_TOKEN=            # fallback, only needed if SHAREPOINT_TOKEN is unset
# GRAPH_BASE_URL=         # optional override (default https://graph.microsoft.com/v1.0)

# --- Pipeline worker ---
# How many BullMQ pipeline jobs are processed concurrently. Defaults to 4
# (unset = same behavior as before this option existed).
PIPELINE_WORKER_CONCURRENCY=

# --- Batch/folder ingestion (NEW-05) ---
# Global cap on batch-originated SURVEY jobs concurrently pending/running
# across ALL batches. Defaults to 2. BASELINE files in a batch are never
# throttled.
BATCH_SURVEY_CONCURRENCY=
# How often (ms) BatchPumpService looks for queued files to submit. Defaults
# to 10000.
BATCH_PUMP_INTERVAL_MS=
# Max files accepted in one POST /batches submission. Defaults to 25.
MAX_BATCH_FILES=
# A batch file stuck mid-submit longer than this (ms) is reclaimed for retry
# by the next pump tick. Defaults to 300000 (5 min).
BATCH_SUBMIT_STUCK_MS=

# --- App auth: none. The ADO org URL + PAT (above) ARE the identity and the
# permissions (DocGen pattern) — no session/JWT, no separate identity
# provider. See docs/architecture.md "App auth" / CR4 of the corrected work
# plan for why the earlier JWT/Azure-AD scaffolding was removed.

# --- Infra ---
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://req2ado:req2ado@localhost:5432/req2ado

# --- Ingestion's Chroma dedup vector store ---
# "embedded" (default, unset = same behavior as before this option existed):
# a local chromadb.PersistentClient -- does NOT survive horizontal scaling,
# each ingestion replica gets an independent, incomplete corpus copy.
# "http": connects to a real, shared Chroma server instead (see
# docker-compose.yml's `chroma` service) -- makes ingestion genuinely
# stateless and safe to run as multiple replicas.
CHROMA_MODE=
CHROMA_HOST=
CHROMA_PORT=
