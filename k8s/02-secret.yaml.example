# Template only -- copy to 02-secret.yaml, fill in real values, NEVER
# commit the filled-in file. Values below are plain strings (`stringData`,
# not `data`) so you don't have to pre-base64-encode them; kubectl/the API
# server does that for you on apply.
#
#   cp 02-secret.yaml.example 02-secret.yaml
#   # edit 02-secret.yaml with real values
#   kubectl apply -f 02-secret.yaml
#
# Deliberately NOT here: the ADO PAT itself. Per docs/architecture.md, the
# PAT is never a server-side credential in this architecture at all -- it's
# entered per-request at the login screen and forwarded as a header,
# per-user, never persisted server-side. Nothing to put in a cluster Secret
# for it.
apiVersion: v1
kind: Secret
metadata:
  name: req2ado-secrets
  namespace: req2ado
type: Opaque
stringData:
  POSTGRES_PASSWORD: "change-me"
  DATABASE_URL: "postgresql://req2ado:change-me@postgres.req2ado.svc.cluster.local:5432/req2ado"
  # Bearer orchestrator's /llm/* proxy routes require (service-to-service
  # only, never called from the frontend) -- pick any strong random string.
  LLM_PROXY_BEARER: "change-me"
  # Optional -- only needed if your LLM_BASE_URL target requires an API key
  # (e.g. a hosted OpenAI-compatible endpoint rather than local Ollama).
  LLM_API_KEY: ""
  # Bearer required on every request to mcp-ado-server's /mcp endpoint --
  # pick any strong random string, must match between orchestrator and
  # mcp-ado-server.
  MCP_BEARER: "change-me"
  # Only needed if the on-prem ADO/TFS server presents a self-signed
  # certificate -- paste the CA bundle's PEM content here; mcp-ado-server
  # mounts it (see 23-mcp-ado-server.yaml) and trusts ONLY this bundle
  # (never disables TLS verification entirely).
  ADO_CA_CERT_PEM: ""
